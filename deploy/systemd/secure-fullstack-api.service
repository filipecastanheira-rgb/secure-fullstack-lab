[Unit]
Description=Secure Fullstack Lab — FastAPI backend
After=network.target

[Service]
Type=simple
User=secure-app
Group=secure-app
WorkingDirectory=/opt/secure-fullstack/backend
ExecStart=/opt/secure-fullstack/venv/bin/python3 -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --no-access-log
Restart=on-failure
RestartSec=3

# Sandboxing. Measured with `systemd-analyze security`.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/secure-fullstack
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

# Second round: capabilities, sockets, namespaces, devices, /proc, syscalls.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
PrivateDevices=true
SystemCallArchitectures=native
RemoveIPC=true
ProtectProc=invisible
ProcSubset=pid
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
