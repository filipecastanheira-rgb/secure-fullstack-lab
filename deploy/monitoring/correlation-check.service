[Unit]
Description=Correlation check for the Secure Fullstack Lab
Documentation=https://github.com/filipecastanheira-rgb/secure-fullstack-lab/blob/main/deploy/monitoring/README.md
After=nginx.service secure-fullstack-api.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/correlation-check.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=correlation-check

[Install]
WantedBy=multi-user.target
