[Unit]
Description=Generate GoAccess HTML report from Nginx access log
Documentation=https://github.com/filipecastanheira-rgb/secure-fullstack-lab/blob/main/deploy/monitoring/README.md
After=nginx.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/generate-goaccess-report.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goaccess-report

# Sandboxing. Measured with `systemd-analyze security`.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/goaccess
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
UMask=0077
PrivateDevices=true
ProtectClock=true
ProtectKernelLogs=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
