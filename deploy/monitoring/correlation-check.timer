[Unit]
Description=Run the correlation check every 5 minutes
Documentation=https://github.com/filipecastanheira-rgb/secure-fullstack-lab/blob/main/deploy/monitoring/README.md

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
AccuracySec=1s
Persistent=true
Unit=correlation-check.service

[Install]
WantedBy=timers.target
