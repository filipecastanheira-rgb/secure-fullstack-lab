[Unit]
Description=Backup the Secure Fullstack Lab database
Documentation=file:///home/filipe/secure-fullstack-lab/deploy/backup/README.md
After=secure-fullstack-api.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/home/filipe/secure-fullstack-lab/deploy/backup/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=secure-fullstack-backup

[Install]
WantedBy=multi-user.target
