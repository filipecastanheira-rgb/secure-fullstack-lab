[Unit]
Description=Backup the Secure Fullstack Lab database
Documentation=https://github.com/filipecastanheira-rgb/secure-fullstack-lab/blob/main/deploy/backup/README.md
After=secure-fullstack-api.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=secure-fullstack-backup

# Sandboxing. Measured with `systemd-analyze security`.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/backups/secure-fullstack
ReadOnlyPaths=/var/lib/secure-fullstack
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
