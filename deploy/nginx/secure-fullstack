# =============================================================================
# Rate limiting zones
# These MUST be defined at the http level (outside any server block),
# which is why they are at the top of this file before the first `server`.
# =============================================================================

# Bucket for the login endpoint. Keyed by client IP.
# 5 requests per minute is generous for a human (who tries 1-2 times),
# and punishing for a script (100k passwords would take ~14 days).
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;

# Bucket for the rest of the API. More permissive because normal
# application usage (page loads, asset lists, form submissions) generates
# more legitimate traffic.
limit_req_zone $binary_remote_addr zone=api:10m rate=60r/m;


# =============================================================================
# HTTP — everything gets redirected to HTTPS.
# No content is served over plain HTTP anymore.
# =============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name 192.168.1.173;
    server_tokens off;

    return 301 https://$server_name$request_uri;
}

# =============================================================================
# HTTPS — the real site.
# =============================================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name 192.168.1.173;
    server_tokens off;

    # --- TLS ---
    ssl_certificate     /etc/nginx/ssl/secure-fullstack/server.crt;
    ssl_certificate_key /etc/nginx/ssl/secure-fullstack/server.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # --- Security headers ---
    include /etc/nginx/snippets/security-headers.conf;

    # --- Static content ---
    root /var/www/secure-fullstack;
    index index.html;

    access_log /var/log/nginx/secure-fullstack.access.log;
    error_log  /var/log/nginx/secure-fullstack.error.log;

    # --- Authentication endpoints: strict rate limit ---
    # Must come before the generic /api/ location, otherwise it would be
    # shadowed by it (Nginx matches the most specific prefix first).
    location = /api/auth/login {
        limit_req zone=login burst=3 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- API: general rate limit ---
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Long-cached immutable assets (content-hashed by Vite) ---
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";

        # add_header in a location replaces ALL add_header inherited from the
        # server block, so the shared security headers are included here again.
        include /etc/nginx/snippets/security-headers.conf;

        try_files $uri =404;
    }

    # --- SPA fallback ---
    # index.html is the entry point that references the content-hashed
    # assets, so browsers must revalidate it (ETag) before reusing it.
    # The same response is served for unknown paths through the fallback.
    location / {
        add_header Cache-Control "no-cache";

        # add_header in a location replaces ALL add_header inherited from the
        # server block, so the shared security headers are included here again.
        include /etc/nginx/snippets/security-headers.conf;

        try_files $uri $uri/ /index.html;
    }
}
