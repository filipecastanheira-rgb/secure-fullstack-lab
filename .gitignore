# ---------- Python / FastAPI ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Base de dados local (SQLite)
*.db
*.sqlite
*.sqlite3

# ---------- Node / Vue / Vite ----------
node_modules/
dist/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Variáveis de ambiente / segredos ----------
.env
.env.*
!.env.example

# ---------- Editores ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db


# ---------- TLS / PKI ----------
# Certificates and keys MUST never be committed to the repository.
# Private keys in particular are equivalent to passwords.
*.key
*.pem
*.crt
*.csr
*.srl
*.der
*.p12
*.pfx

# The entire CA directory and any local cert storage
certs/
pki/
secrets/

# Never commit environment files with real secrets
*.env.local
*.env.production


# ---------- Application secrets ----------
# JWT secret file — generated on first startup, gitignored.
.jwt_secret
